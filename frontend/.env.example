# Frontend Environment Variables

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Gateway URLs
NEXT_PUBLIC_CONTENT_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_CONCEPT_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_AUDIO_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_VISUAL_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:3002

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WHITELABEL=true
