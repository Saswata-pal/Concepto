# ============================================
# CONCEPTO - Environment Variables Template
# ============================================

# -------------------- Frontend --------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -------------------- Databases --------------------
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/concepto

# MongoDB
MONGODB_URI=mongodb://localhost:27017/concepto

# Redis
REDIS_URL=redis://localhost:6379

# TimescaleDB (Analytics)
TIMESCALE_URL=postgresql://user:password@localhost:5432/concepto_analytics

# -------------------- API Keys --------------------
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs (Audio/TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Deepgram (ASR)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Pinecone (Vector DB)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment

# Replicate (Stable Diffusion)
REPLICATE_API_TOKEN=your_replicate_token_here

# -------------------- Storage --------------------
# AWS S3 or MinIO
S3_BUCKET_NAME=concepto-content
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000  # For MinIO

# -------------------- Message Queue --------------------
# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -------------------- Authentication --------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# -------------------- Service Ports --------------------
CONTENT_SERVICE_PORT=3001
CONCEPT_SERVICE_PORT=8001
AUDIO_SERVICE_PORT=8002
VISUAL_SERVICE_PORT=8003
PERSONA_SERVICE_PORT=8004
RECALL_SERVICE_PORT=8005
USER_SERVICE_PORT=3002
WHITELABEL_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004

# -------------------- Monitoring --------------------
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3005
GRAFANA_ADMIN_PASSWORD=admin

# -------------------- Misc --------------------
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=info
